unmanaged implementation in class zbp_r_deliveryheadertp unique;
strict ( 2 );

define behavior for ZR_DeliveryHeaderTp alias DelHead
//late numbering
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly : update ) Vbeln;
  association _item { create; }

  mapping for ylikp control ylikp_control_struct
    {
      Vbeln   = vbeln;
      Ernam   = ernam;
      Erzet   = erzet;
      Erdat   = erdat;
      Bzirk   = bzirk;
      Vstel   = vstel;
      Vkorg   = vkorg;
      Lfart   = lfart;
    }
}

define behavior for ZI_DeliveryItem alias DelLine
//late numbering
lock dependent by _header
authorization dependent by _header
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) Vbeln;
  field ( readonly : update ) Posnr;
  association _header;
}