@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: 'Journal Entry',
    typeNamePlural: 'Journal Entries',
    title: { type: #STANDARD, value: 'Belnr' },
    description: { type: #STANDARD, label: 'Rldnr', value: 'Rbukrs' }
  }

annotate view ZC_UnivJournalEntry with
{
  @UI.facet: [
    {
      id: 'GeneralInfo',
      label: 'General Information',
      type: #IDENTIFICATION_REFERENCE,
      position: 10
    }
  ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10, dataAction: 'PostVendorInv', label: 'Post Vendor Invoice'}]
  @UI.selectionField: [{ position: 10 }]
  Rldnr;
  @UI: { lineItem: [{ position: 20 }], identification: [{ position: 20 }], selectionField: [{ position: 20 }] }
  Rbukrs;

  @UI: { lineItem: [{ position: 30 }], identification: [{ position: 30 }], selectionField: [{ position: 30 }] }
  Gjahr;

  @UI: { lineItem: [{ position: 40 }], identification: [{ position: 40 }] }
  Belnr;

  @UI: { lineItem: [{ position: 50 }], identification: [{ position: 50 }] }
  Docln;

  @UI: { lineItem: [{ position: 60 }], identification: [{ position: 60 }], selectionField: [{ position: 40 }] }
  Blart;

  @UI: { lineItem: [{ position: 70 }], identification: [{ position: 70 }] }
  Kostl;

  @UI: { lineItem: [{ position: 80 }], identification: [{ position: 80 }] }
  Tsl;

  @UI: { lineItem: [{ position: 90 }], identification: [{ position: 90 }] }
  Rtcur;

  @UI: { lineItem: [{ position: 100 }], identification: [{ position: 100 }], selectionField: [{ position: 50 }] }
  Werks;

  @UI: { lineItem: [{ position: 110 }], identification: [{ position: 110 }], selectionField: [{ position: 60 }] }
  Lifnr;

  @UI: { lineItem: [{ position: 120 }], identification: [{ position: 120 }] }
  drcrk;


}