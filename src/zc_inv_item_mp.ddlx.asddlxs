@Metadata.layer: #CUSTOMER
annotate view ZC_INV_ITEM_MP with
{
  @UI.facet: [
    { id:              'ItemData',
      type:            #FIELDGROUP_REFERENCE,
      targetQualifier: 'ItemGrp',
      label:           'Item Details',
      position:        10 }
  ]
  ItemUuid;

  @UI.lineItem: [{ position: 10, label: 'Item No.' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGrp', position: 10, label: 'Item No.' }]
  ItemNo;

  @UI.lineItem: [{ position: 20, label: 'Material' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGrp', position: 20, label: 'Material' }]
  Material;

  @UI.lineItem: [{ position: 30, label: 'PO Item' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGrp', position: 30, label: 'PO Item' }]
  PoItem;

  @UI.lineItem: [{ position: 40, label: 'Quantity' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGrp', position: 40, label: 'Quantity' }]
  Quantity;

  @UI.lineItem: [{ position: 50, label: 'Unit' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGrp', position: 50, label: 'Unit' }]
  Unit;

  @UI.lineItem: [{ position: 60, label: 'Amount' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGrp', position: 60, label: 'Amount' }]
  Amount;

  @UI.lineItem: [{ position: 70, label: 'Currency' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGrp', position: 70, label: 'Currency' }]
  Currency;

  @UI.lineItem: [{ position: 80, label: 'Tax Code' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGrp', position: 80, label: 'Tax Code' }]
  TaxCode;

  @UI.lineItem: [{ position: 90, label: 'Match Status' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGrp', position: 90, label: 'Match Status' }]
  MatchStatus;
}